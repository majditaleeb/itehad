@model IEnumerable<itehad.Models.AppUser>
@using itehad.Helpers
@{
    ViewBag.Title = "المستخدمون";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div></div>
    <a href="@Url.Action("Create")" class="btn btn-accent">@Icons.PlusCircle() مستخدم جديد</a>
</div>

<div class="table-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>اسم المستخدم</th>
                    <th>الاسم الظاهر</th>
                    <th>النوع</th>
                    <th>الحالة</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td class="fw-semibold">@u.Username</td>
                        <td>@u.DisplayName</td>
                        <td>@(u.IsAdmin ? "مدير (صلاحية كاملة)" : "موظف")</td>
                        <td>
                            @if (u.IsActive)
                            {
                                <span class="pill pill-green">فعّال</span>
                            }
                            else
                            {
                                <span class="pill pill-gray">معطّل</span>
                            }
                        </td>
                        <td class="text-start d-flex gap-1 justify-content-end">
                            @using (Html.BeginForm("ToggleActive", "Users", FormMethod.Post, new { style = "display:inline" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@u.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary">@(u.IsActive ? "تعطيل" : "تفعيل")</button>
                            }
                            <a href="@Url.Action("Edit", new { id = u.Id })" class="btn btn-sm btn-outline-secondary">@Icons.Edit()</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
