@model itehad.Models.ViewModels.UserFormViewModel
@using itehad.Helpers

@Html.AntiForgeryToken()
@Html.HiddenFor(m => m.Id)

<div class="row g-3">
    <div class="col-md-6">
        <label class="form-label">اسم المستخدم</label>
        @Html.TextBoxFor(m => m.Username, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger small" })
    </div>
    <div class="col-md-6">
        <label class="form-label">الاسم الظاهر</label>
        @Html.TextBoxFor(m => m.DisplayName, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.DisplayName, "", new { @class = "text-danger small" })
    </div>
    <div class="col-md-6">
        <label class="form-label">كلمة المرور @(Model.Id > 0 ? "(اتركها فارغة إن لم ترغب بتغييرها)" : "")</label>
        @Html.PasswordFor(m => m.Password, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
    </div>
    <div class="col-md-6 d-flex align-items-end gap-4">
        <div class="form-check">
            @Html.CheckBoxFor(m => m.IsAdmin, new { @class = "form-check-input", id = "IsAdmin" })
            <label class="form-check-label" for="IsAdmin">مدير (صلاحية كاملة)</label>
        </div>
        <div class="form-check">
            @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" })
            <label class="form-check-label">فعّال</label>
        </div>
    </div>

    <div class="col-12" data-modules-wrap>
        <label class="form-label">الشاشات المسموحة لهذا المستخدم</label>
        <div class="row g-2">
            @foreach (var key in Modules.Grantable)
            {
                var isChecked = Model.SelectedModules != null && Model.SelectedModules.Contains(key);
                <div class="col-md-6">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="SelectedModules" value="@key" id="mod_@key" @(isChecked ? "checked" : "") />
                        <label class="form-check-label" for="mod_@key">@Modules.DisplayNames[key]</label>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<div class="d-flex gap-2 mt-4">
    <button type="submit" class="btn btn-accent px-4">حفظ</button>
    <a href="@Url.Action("Index")" class="btn btn-outline-secondary">إلغاء</a>
</div>

<script>
    (function () {
        var adminCheckbox = document.getElementById("IsAdmin");
        var modulesWrap = document.querySelector("[data-modules-wrap]");
        function toggle() {
            modulesWrap.style.display = adminCheckbox.checked ? "none" : "";
        }
        adminCheckbox.addEventListener("change", toggle);
        toggle();
    })();
</script>
