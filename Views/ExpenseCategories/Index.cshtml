@model IEnumerable<itehad.Models.ExpenseCategory>
@using itehad.Helpers
@{
    ViewBag.Title = "تصنيفات المصاريف";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div></div>
    <button type="button" class="btn btn-accent" data-bs-toggle="modal" data-bs-target="#addCategoryModal">@Icons.PlusCircle() تصنيف جديد</button>
</div>

<div class="table-card">
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>اسم التصنيف</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@c.Name</td>
                            <td class="text-start d-flex gap-1 justify-content-end">
                                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#editCategoryModal_@c.Id">@Icons.Edit()</button>
                                @using (Html.BeginForm("Delete", "ExpenseCategories", FormMethod.Post, new { style = "display:inline", data_confirm = "هل تريد حذف هذا التصنيف؟" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@c.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">@Icons.XCircle()</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            @Icons.Tag()
            <div>لا توجد تصنيفات مسجّلة بعد</div>
        </div>
    }
</div>

@foreach (var c in Model)
{
    <div class="modal fade" id="editCategoryModal_@c.Id" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                @using (Html.BeginForm("Edit", "ExpenseCategories", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Id" value="@c.Id" />
                    <div class="modal-header">
                        <h5 class="modal-title">تعديل التصنيف</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label">اسم التصنيف</label>
                        <input type="text" name="Name" class="form-control" value="@c.Name" />
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">إلغاء</button>
                        <button type="submit" class="btn btn-accent">حفظ</button>
                    </div>
                }
            </div>
        </div>
    </div>
}

<div class="modal fade" id="addCategoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            @using (Html.BeginForm("Create", "ExpenseCategories", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">تصنيف جديد</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label">اسم التصنيف</label>
                    <input type="text" name="Name" class="form-control" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-accent">إضافة</button>
                </div>
            }
        </div>
    </div>
</div>
