@model itehad.Models.ViewModels.TripListViewModel
@using itehad.Models
@{
    Layout = "~/Views/Shared/_PrintLayout.cshtml";
}

<h2 class="h5 fw-bold mb-1">
    @(Model.IsRange ? "سجل الحركة" : "سجل الحركة اليومية") &mdash;
    @if (Model.IsRange)
    {
        <text>من @Model.FromDate.ToString("yyyy-MM-dd") إلى @Model.ToDate.ToString("yyyy-MM-dd")</text>
    }
    else
    {
        <text>@Model.FromDate.ToString("yyyy-MM-dd")</text>
    }
</h2>
<p class="text-muted small mb-3">عدد الرحلات: @Model.Trips.Count</p>

<table class="table table-bordered table-sm">
    <thead>
        <tr>
            <th>الرقم</th>
            @if (Model.IsRange)
            {
                <th>التاريخ</th>
            }
            <th>الوقت</th>
            <th>المصدر</th>
            <th>الزبون</th>
            <th>من - إلى</th>
            <th>السائقون</th>
            <th>الأجرة</th>
            <th>الدفع</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var t in Model.Trips)
        {
            <tr>
                <td>@t.Id</td>
                @if (Model.IsRange)
                {
                    <td>@t.TripDate.ToString("yyyy-MM-dd")</td>
                }
                <td>@t.TripDate.ToString("HH:mm")</td>
                <td>@t.BookingSource.Name</td>
                <td>@t.Customer.Name</td>
                <td>@t.FromLocation.Name &larr; @t.ToLocation.Name</td>
                <td>@string.Join("، ", t.TripDrivers.Select(td => td.Driver.Name))</td>
                <td>@(t.Currency == CurrencyType.ILS ? "₪" : "$")@t.Fare.ToString("N0")</td>
                <td>@(t.PaymentMethod == PaymentMethodType.Cash ? "نقدي" : "ذمم")</td>
            </tr>
        }
    </tbody>
</table>

<p class="fw-bold">
    إجمالي النقدي: @("₪" + Model.CashILS.ToString("N0")) / @("$" + Model.CashUSD.ToString("N0"))
    &nbsp;&mdash;&nbsp;
    إجمالي الذمم: @("₪" + Model.CreditTotalILS.ToString("N0")) / @("$" + Model.CreditTotalUSD.ToString("N0"))
</p>
