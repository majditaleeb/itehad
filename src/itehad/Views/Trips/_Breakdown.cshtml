@model itehad.Models.ViewModels.TripListViewModel
@using itehad.Models
@{
    var symbol = (string)ViewBag.Symbol;
    var total = (decimal)ViewBag.Total;
    var rowCap = (int)ViewBag.RowCap;
    var truncated = Model.TotalCount > Model.Trips.Count;
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div class="text-muted small">
        @Model.PeriodLabel &nbsp;&bull;&nbsp; @Model.TotalCount رحلة
    </div>
    <div class="fw-bold fs-5">@(symbol + total.ToString("N0"))</div>
</div>

@if (Model.Trips.Any())
{
    if (truncated)
    {
        <div class="alert alert-warning py-2 small">
            العدد كبير — معروض أول @rowCap رحلة من أصل @Model.TotalCount. المجموع أعلاه يشمل الرحلات كلها.
        </div>
    }

    <div class="table-responsive" style="max-height:60vh; overflow-y:auto">
        <table class="table table-sm table-hover align-middle mb-0">
            <thead class="table-light" style="position:sticky; top:0; z-index:1">
                <tr>
                    <th>الرقم</th>
                    <th>التاريخ</th>
                    <th>الوقت</th>
                    <th>المصدر</th>
                    <th>الزبون</th>
                    <th>من - إلى</th>
                    <th>السائقون</th>
                    <th class="text-start">الأجرة</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model.Trips)
                {
                    <tr>
                        <td class="fw-bold text-muted">@t.Id</td>
                        <td class="text-nowrap">@t.TripDate.ToString("yyyy-MM-dd")</td>
                        <td>@t.TripDate.ToString("HH:mm")</td>
                        <td>@t.BookingSource.Name</td>
                        <td class="fw-semibold">@t.Customer.Name</td>
                        <td>@t.FromLocation.Name <span class="route-arrow">←</span> @t.ToLocation.Name</td>
                        <td>@string.Join("، ", t.TripDrivers.Select(td => td.Driver.Name))</td>
                        <td class="text-start fw-semibold text-nowrap">@(symbol + t.Fare.ToString("N0"))</td>
                    </tr>
                }
            </tbody>
            <tfoot class="table-light">
                <tr>
                    <th colspan="7" class="text-end">المجموع</th>
                    <th class="text-start text-nowrap">@(symbol + total.ToString("N0"))</th>
                </tr>
            </tfoot>
        </table>
    </div>
}
else
{
    <div class="empty-state py-4">
        <div>لا توجد رحلات ضمن هذا البند في الفترة المحددة</div>
    </div>
}
